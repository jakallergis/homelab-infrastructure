[Unit]
Description=AdGuard Home {{ adguard_version }}
Wants=network-online.target
After=network-online.target

[Service]
User=adguardhome
Group=adguardhome
# Ports 53 and 80 need this capability. The service gets no other.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# Ansible installs new versions. AdGuard Home must not update itself.
ExecStart=/opt/AdGuardHome/{{ adguard_version }}/AdGuardHome/AdGuardHome --config /var/lib/adguardhome/AdGuardHome.yaml --work-dir /var/lib/adguardhome --no-check-update
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
